#!/bin/bash
# 更新后回调：恢复配置 -> 加载预置镜像 -> 重建容器

. "$(dirname "$0")/_lib.sh"

ENV_FILE="${TRIM_PKGVAR}/fnmusic.env"
if [ ! -f "$ENV_FILE" ]; then
    # 极少数情况：旧版本没有持久化配置，用当前 .env 或默认值兜底
    if [ -f "${TRIM_APPDEST}/docker/.env" ]; then
        NAS_IP="$(grep -m1 '^NAS_IP=' "${TRIM_APPDEST}/docker/.env" | cut -d= -f2-)"
    fi
    NAS_IP="${NAS_IP:-192.168.31.26}"
    FM_PORT="5666"
    FM_USER=""
    FM_PASS=""
    XM_PORT="58090"
    BR_PORT="58091"
    env_write_full "$NAS_IP" "$FM_PORT" "$FM_USER" "$FM_PASS" "$XM_PORT" "$BR_PORT"
else
    # 升级会替换 target 目录，把持久化配置同步回 compose 目录
    cp "$ENV_FILE" "${TRIM_APPDEST}/docker/.env"
fi
harden_compose_env || { echo "compose 配置生成失败" > "${TRIM_TEMP_LOGFILE}"; exit 1; }

echo "[upgrade] 加载预置镜像..."
if ! load_local_images; then
    echo "预置镜像加载失败，请检查磁盘空间后重试。" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

echo "[upgrade] 重建容器..."
# 与 install_callback 同理：必须带 -p 项目名（appcenter 的工作目录是
# /vol3/@appcenter/<app>/docker，裸跑会因项目名推断错误而容器名冲突）
COMPOSE_DIR=""
for d in "/vol3/@appcenter/${TRIM_APPNAME}/docker" "${TRIM_APPDEST}/docker"; do
    if [ -f "$d/docker-compose.yaml" ]; then COMPOSE_DIR="$d"; break; fi
done
if [ -n "$COMPOSE_DIR" ]; then
    cd "$COMPOSE_DIR" && docker compose -p "${TRIM_APPNAME}" up -d
else
    cd "${TRIM_APPDEST}/docker" && docker compose up -d
fi

echo "[upgrade] 完成"
exit 0
