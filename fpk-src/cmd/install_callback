#!/bin/bash
# 安装后回调：写入配置 -> 加载预置镜像 -> 建数据目录

. "$(dirname "$0")/_lib.sh"

NAS_IP="${nas_ip:-${wizard_nas_ip:-192.168.31.26}}"
FM_PORT="${fnmusic_port:-${wizard_fnmusic_port:-5666}}"
FM_USER="${fnmusic_username:-${wizard_fnmusic_username:-}}"
FM_PASS="${fnmusic_password:-${wizard_fnmusic_password:-}}"
XM_PORT="${xiaomusic_port:-${wizard_xiaomusic_port:-58090}}"
BR_PORT="${bridge_port:-${wizard_bridge_port:-58091}}"

if [ -z "$FM_USER" ] || [ -z "$FM_PASS" ]; then
    echo "飞牛音乐账号或密码为空，请重新安装并填写。" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

echo "[install] 写入配置..."
env_write_full "$NAS_IP" "$FM_PORT" "$FM_USER" "$FM_PASS" "$XM_PORT" "$BR_PORT"
sync_ui_ports "$XM_PORT" "$BR_PORT"
harden_compose_env || { echo "compose 配置生成失败" > "${TRIM_TEMP_LOGFILE}"; exit 1; }

echo "[install] 创建数据目录..."
SHARES="$(detect_shares_root)/${TRIM_APPNAME}"
mkdir -p "${SHARES}/music" "${SHARES}/conf" "${SHARES}/bridge"

# 恢复上次卸载前的数据（小米账号绑定状态等）
BACKUP_DIR="/var/apps/${TRIM_APPNAME}.shares-backup"
if [ -d "$BACKUP_DIR" ]; then
    cp -a "$BACKUP_DIR/." "${SHARES}/" 2>/dev/null || true
    echo "[install] 已恢复历史数据（小米账号绑定状态等）"
fi

echo "[install] 加载预置镜像..."
if ! load_local_images; then
    echo "预置镜像加载失败，请检查磁盘空间后重试。" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi

# appcenter 会在回调执行前就用未替换的 compose 启动容器（env 落默认值，
# 实测 FNMUSIC_USERNAME/PASSWORD 为空导致登录失败）。
# 这里用硬替换后的最终配置重建容器，保证容器拿到正确的环境变量。
echo "[install] 用最终配置重建容器..."
COMPOSE_DIR=""
for d in "/vol3/@appcenter/${TRIM_APPNAME}/docker" "${TRIM_APPDEST}/docker"; do
    if [ -f "$d/docker-compose.yaml" ]; then COMPOSE_DIR="$d"; break; fi
done
if [ -n "$COMPOSE_DIR" ]; then
    cd "$COMPOSE_DIR" && docker compose -p "${TRIM_APPNAME}" up -d 2>&1 | tail -5 || true
fi

echo "[install] 完成"
exit 0
