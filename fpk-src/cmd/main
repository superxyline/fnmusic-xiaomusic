#!/bin/bash
# 主控脚本：启停与状态检查
# docker 应用由 appcenter 调用 compose 管理，这里做双保险

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH

COMPOSE_DIR="${TRIM_APPDEST}/docker"
CONTAINERS="xiaomusic fnmusic-bridge"

container_running() {
    docker inspect "$1" >/dev/null 2>&1 || return 1
    docker inspect "$1" 2>/dev/null | grep -q '"Status": "running",'
}

case "$1" in
start)
    cd "$COMPOSE_DIR" && docker compose up -d
    ;;
stop)
    cd "$COMPOSE_DIR" && docker compose down
    ;;
status)
    for c in $CONTAINERS; do
        container_running "$c" || exit 3
    done
    exit 0
    ;;
*)
    exit 1
    ;;
esac
